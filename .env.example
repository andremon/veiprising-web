# Alle er valgfrie. Siden og nedlastingene fungerer uten noe av dette.

# Hvis siden ligger på et underområde, f.eks. a5.no/bompenger:
BASE_PATH=/bompenger

# Postgres for besøksteller + folkekrav-avstemning.
# Railway setter DATABASE_URL automatisk når du legger til en Postgres-database.
# Uten den er siden lesbar og nedlastbar, men teller/avstemning er skjult.
DATABASE_URL=

# Hemmelig salt for anonym IP-hashing i folkekravet (sett en egen verdi).
HASH_SALT=bytt-meg-til-noe-tilfeldig
